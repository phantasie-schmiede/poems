{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSB\\PsbPoems\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSB\\PsbPoems\\Tests\\": "Tests/"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "Manage and display poems",
    "extra": {
        "typo3/cms": {
            "app-dir": ".Build",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "psb_poems",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psb/psb-poems",
    "require": {
        "psb/psb-foundation": "^2"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.0.9"
    },
    "type": "typo3-cms-extension"
}
