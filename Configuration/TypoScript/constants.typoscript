plugin.tx_poems {
    # cat=plugin.tx_poems//a; type=int+; label=Default storage PID
    persistence.storagePid =

    view {
        # cat=plugin.tx_poems/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:poems/Resources/Private/Layouts/

        # cat=plugin.tx_poems/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:poems/Resources/Private/Partials/

        # cat=plugin.tx_poems/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:poems/Resources/Private/Templates/
    }
}
