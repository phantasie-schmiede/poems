		partialRootPath = EXT:psb_poems/Resources/Private/Partials/
		# cat=plugin.tx_psbpoems/file; type=string; label=Path to template layouts (FE)
		layoutRootPath = EXT:psb_poems/Resources/Private/Layouts/
	}

	persistence {
		# cat=plugin.tx_psbpoems//a; type=string; label=Default storage PID
		storagePid =
	}
}
