page {
    includeCSS.psb_poems = EXT:psb_poems/Resources/Public/Stylesheets/Main.scss
    includeJSFooter.psb_poems_accordion = EXT:psb_poems/Resources/Public/JavaScript/App.js
    includeJSFooterlibs.isotope = EXT:ps_configuration/Resources/Public/JavaScript/Libraries/isotope.pkgd.min.js
}

plugin.tx_psbpoems {
	view {
		templateRootPaths.0 = {$plugin.tx_psbpoems.view.templateRootPath}
		partialRootPaths.0 = {$plugin.tx_psbpoems.view.partialRootPath}
		layoutRootPaths.0 = {$plugin.tx_psbpoems.view.layoutRootPath}
	}

	persistence {
		storagePid = {$plugin.tx_psbpoems.persistence.storagePid}
	}
}
